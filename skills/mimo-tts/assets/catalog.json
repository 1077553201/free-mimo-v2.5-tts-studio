  "style_presets": [
    {
      "label": "报喜",
      "text": "用轻快上扬的语调向领导报喜，语速稍快，带着查到成绩后压抑不住的激动与小骄傲，声音明亮有活力。"
    },
    {
      "label": "得意",
      "text": "看着刚解决的难题成果忍不住得意忘形地惊呼，声音高亢明亮，语速偏快，语气中带着满满的自信与难以置信。"
    },
    {
      "label": "恶作剧",
      "text": "用明亮活泼的青少年嗓音，带着恶作剧得逞后的得意与戏谑，语速偏快且咬字轻巧，在强调赌注时语气微微上扬。"
    },
    {
      "label": "深夜电台",
      "text": "深夜电台主播，声音低沉有磁性，气息松弛，语速偏慢，像在耳边轻声说话，句尾略带慵懒。"
    },
    {
      "label": "科普旁白",
      "text": "纪录片旁白，中低音，吐字清晰有力，节奏稳定，客观中带有克制的敬意，不做过多情绪起伏。"
    },
    {
      "label": "广告口播",
      "text": "高能量广告口播，节奏紧凑明快，重音落在卖点上，句末上扬收尾，带着强烈的推荐欲。"
    },
    {
      "label": "温柔哄睡",
      "text": "极轻柔的哄睡语气，气声多、实声少，语速非常慢，句与句之间留出明显停顿，像哄小孩一样耐心。"
    },
    {
      "label": "悬疑叙事",
      "text": "悬疑故事讲述者，压低嗓音，语速忽快忽慢，关键处刻意放慢并加重咬字，制造压迫感与悬念。"
    },
    {
      "label": "激情解说",
      "text": "体育赛事解说，情绪高涨，语速极快，音量起伏大，关键瞬间拔高音量大喊，带着难以抑制的兴奋。"
    },
    {
      "label": "冷静播报",
      "text": "新闻播报，标准普通话，语速中等偏慢，语调平稳，重音准确，不带个人情绪，端庄克制。"
    },
    {
      "label": "古风评书",
      "text": "评书先生，中老年男声，文白杂糅，讲究抑扬顿挫，关键处以惊堂木般的重音收束，余韵悠长。"
    },
    {
      "label": "ASMR 低语",
      "text": "贴近麦克风的耳语，气声明显，呼吸声清晰可闻，语速缓慢，字与字之间带着黏连感，让人放松。"
    }
  ],
